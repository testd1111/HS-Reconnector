<Window x:Class="HS_Reconnector.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HS_Reconnector.UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">
    <Border x:Name="RootBorder"
            Width="176"
            Height="46"
            Background="Transparent"
            Cursor="Hand"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp"
            MouseRightButtonDown="RootBorder_MouseRightButtonDown"
            MouseMove="RootBorder_MouseMove"
            MouseRightButtonUp="RootBorder_MouseRightButtonUp"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Grid>
            <Border x:Name="BackgroundPlate"
                    Background="#0E1013"
                    BorderBrush="#0B0D10"
                    BorderThickness="2">
                <Border x:Name="InnerBorder"
                        Background="#23272D"
                        BorderBrush="#4E555E"
                        BorderThickness="1" />
            </Border>
            <Viewbox x:Name="StatusViewbox"
                     Margin="13,5"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False">
                <ui:OutlinedTextBlock x:Name="StatusText"
                                      Text="Reconnect"
                                      FontFamily="Bookman Old Style, Georgia, Segoe UI"
                                      FontSize="19"
                                      FontWeight="Bold"
                                      Fill="#FFFFFF"
                                      Stroke="#090B0E"
                                      StrokeThickness="2.8" />
            </Viewbox>
        </Grid>
    </Border>
</Window>
